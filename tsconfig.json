{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2021",
		"moduleResolution": "node",
		"lib": ["DOM", "ES2021"],
		"strictNullChecks": true,
		"noImplicitAny": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"inlineSourceMap": true,
		"inlineSources": true,
		"allowJs": true
	},
	"include": ["src/**/*.ts"]
}
